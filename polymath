def cmd_show(args):
    corpus = Corpus.find(Path(args.root) if args.root else None)
    rec = corpus.records[resolve_id(corpus, args.id)]
    prov = rec.get("provenance", {}) or {}
    print(f"{rec['type']}  {rec['id']}")
    print(f"{rec['title']}")
    line = f"by {rec['author']}   provenance: {prov.get('kind')}"
    if prov.get("model"):
        line += f" ({prov['model']})"
    print(line)
    if rec.get("type") in ("theorem", "conjecture"):
        print(f"standing: {verification_status(corpus, rec['id'])}")
    if rec.get("asserted_confidence"):
        print(f"author's own confidence: {rec['asserted_confidence']}")
    print()
    print(rec.get("body", ""))
    if rec.get("what_was_tried"):
        print("\nWhat was tried:\n" + rec["what_was_tried"])

    # Every linked record is numbered, so you can follow a link by typing its
    # number rather than an identifier. Each one says what KIND of record it is:
    # "depends on a question" and "depends on a claim" mean quite different things.
    neighbours = []
    if rec.get("links"):
        print("\nLinks out — what this record says about others:")
        for l in rec["links"]:
            tgt = corpus.records.get(l.get("target"), {})
            effect = ("takes effect at once" if l.get("rel") in SOURCE_RELS
                      else "advisory until its author agrees")
            neighbours.append(l.get("target"))
            n = len(neighbours)
            print(f"  {n:>3}  {l.get('rel'):<12} {tgt.get('type', '?'):<16} "
                  f"{tgt.get('title', l.get('target'))}")
            extra = ""
            if tgt.get("type") in ("theorem", "conjecture"):
                extra = ", " + verification_status(corpus, tgt["id"])
            print(f"       {str(l.get('target', ''))[:12]}   ({effect}{extra})")

    inbound = [(l["rel"], r) for r in corpus.records.values()
               for l in r.get("links", []) if l.get("target") == rec["id"]]
    if inbound:
        print("\nLinks in — what others say about this record:")
        for rel, r in inbound:
            neighbours.append(r["id"])
            n = len(neighbours)
            print(f"  {n:>3}  {rel:<12} {r.get('type', '?'):<16} {r.get('title', '')}")
            print(f"       {r['id'][:12]}   by {r['author']}")

    if neighbours:
        save_shortlist(corpus, neighbours)
        print("\nFollow one with its number, e.g.  polymath show 1")
    return 0


def cmd_graph(args):
    corpus = Corpus.find(Path(args.root) if args.root else None)
    args.id = resolve_id(corpus, args.id)
    seen = set()

    def walk(rid, depth, rel="", up=False):
        if depth > args.depth or rid in seen:
            return
        seen.add(rid)
        r = corpus.records.get(rid, {})
        print("  " * depth + f"{'^' if up else '>'} {rel:<12} {rid}  {r.get('title', '')}")
        for l in r.get("links", []):
            walk(l.get("target"), depth + 1, l.get("rel", ""))

    walk(args.id, 0)
    return 0


def cmd_list(args):
    """Everything there is, grouped, for when you do not know what to search for."""
    corpus = Corpus.find(Path(args.root) if args.root else None)
    recs = list(corpus.records.values())
    if not recs:
        print("There are no records yet. Write the first one:  polymath new question")
        return 0

    linked_to = {l.get("target") for r in recs for l in r.get("links", [])}
    order = ["question", "conjecture", "theorem", "argument", "counterexample", "obstruction",
             "artifact", "note", "reference", "verdict", "statement_review",
             "agreement", "vote"]
    shortlist, n = [], 0
    for rtype in order + sorted({r["type"] for r in recs} - set(order)):
        group = [r for r in recs if r.get("type") == rtype]
        if not group:
            continue
        if args.type and rtype != args.type:
            continue
        group.sort(key=lambda r: r.get("title", ""))
        print(f"\n{rtype.upper()}  ({len(group)})")
        for rec in group:
            n += 1
            shortlist.append(rec["id"])
            marks = []
            tag = status_tag(corpus, rec)
            if tag:
                marks.append(tag)
            if rec["id"] not in linked_to and not rec.get("links"):
                marks.append("unconnected")
            tag = ("  [" + ", ".join(marks) + "]") if marks else ""
            print(f"  {n:>3}  {rec.get('title', '')}{tag}")
            print(f"       {rec['id'].split('-', 1)[0]}   by {rec['author']}")
    save_shortlist(corpus, shortlist)
    orphans = [r for r in recs if r["id"] not in linked_to and not r.get("links")]
    print(f"\n{len(recs)} records, {len(corpus.people)} members.")
    if orphans:
        print(f"{len(orphans)} marked 'unconnected': nothing links to them and they link")
        print("to nothing, so nobody will come across them by following anything.")
    print("Open one with its number, e.g.  polymath show 1")
    return 0



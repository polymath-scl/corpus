def main(argv=None):
    ap = argparse.ArgumentParser(prog="polymath", description=__doc__.splitlines()[0])
    ap.add_argument("--root", help="corpus root (default: search upwards from here)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init", help="set up a local copy and your identity")
    p.add_argument("--handle"); p.add_argument("--key")
    p.set_defaults(fn=cmd_init)

    p = sub.add_parser("new", help="start writing a record (asks what kind, if "
                                    "you do not say)")
    p.add_argument("type", nargs="?",
                   help="question, claim, obstruction, ... omit it and you will be asked")
    p.add_argument("--title")
    p.add_argument("--author"); p.add_argument("--out")
    p.add_argument("--no-edit", action="store_true", help="do not open an editor")
    p.add_argument("--json", action="store_true",
                   help="write a raw JSON draft instead of markdown")
    p.set_defaults(fn=cmd_new)

    p = sub.add_parser("publish",
                       help="check it, sign it, and offer it to the project")
    p.add_argument("draft"); p.add_argument("--key"); p.add_argument("--author")
    p.add_argument("-y", "--yes", action="store_true",
                   help="skip the confirmation prompt and the questions about links")
    p.add_argument("--no-links", action="store_true",
                   help="do not ask what this connects to")
    p.add_argument("--local-only", action="store_true",
                   help="write and check it, but do not commit or send it")
    p.add_argument("--no-browser", action="store_true",
                   help="print the pull request address instead of opening it")
    p.set_defaults(fn=cmd_publish)

    p = sub.add_parser("validate", help="run every rule (the same code the automatic checks run)")
    p.set_defaults(fn=cmd_validate)

    p = sub.add_parser(
        "search", help="search the record",
        description="Words are matched WHOLE: 'lp' will not match 'help'. Use "
                    "--substring if you want it to. Quote several words to search "
                    "for them as a phrase (\"separating curve\"); a phrase still "
                    "matches when the text wraps between its words. Several bare "
                    "words find records containing any of them, but records "
                    "containing all of them come first. Regular expressions are not "
                    "supported. Titles, bodies and 'what was tried' are searched.")
    p.add_argument("words", nargs="+")
    p.add_argument("--type", help="only this kind of record")
    p.add_argument("--substring", action="store_true",
                   help="match inside words too")
    p.add_argument("--limit", type=int, default=20)
    p.set_defaults(fn=cmd_search)

    p = sub.add_parser("list", help="browse everything, grouped by kind")
    p.add_argument("--type")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("browse", help="open a clickable page of the whole corpus")
    p.add_argument("--no-open", action="store_true", help="just write the file")
    p.set_defaults(fn=cmd_browse)

    p = sub.add_parser("show", help="display one record with its connections")
    p.add_argument("id", help="a number from the last list, a few leading characters "
                              "of an identifier, or the whole thing")
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("graph", help="show what a record depends on")
    p.add_argument("id"); p.add_argument("--depth", type=int, default=3)
    p.set_defaults(fn=cmd_graph)

    p = sub.add_parser("sync", help="fetch others' work, refusing any rewriting of history")
    p.set_defaults(fn=cmd_sync)

    p = sub.add_parser("doctor", help="check the local setup")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("tutorial",
                       help="walk through a first session in a throwaway sandbox")
    p.add_argument("--no-pause", action="store_true",
                   help="do not wait for Enter between steps")
    p.set_defaults(fn=cmd_tutorial)

    args = ap.parse_args(argv)
    try:
        return args.fn(args)
    except Problem as e:
        die(str(e))


if __name__ == "__main__":
    sys.exit(main())

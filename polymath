def cmd_validate(args):
    corpus = Corpus.find(Path(args.root) if args.root else None)
    problems = run_validation(corpus)
    for p in problems:
        print(str(p))
    n_rec = len(corpus.record_paths())
    if problems:
        print(f"\n{len(problems)} problem(s) in {n_rec} record(s), "
              f"{len(corpus.people)} member(s).", file=sys.stderr)
        return 1
    print(f"ok: {n_rec} record(s), {len(corpus.people)} member(s), no problems.")
    return 0


# --------------------------------------------------------------------------
# markdown drafts
#
# You write a record as plain markdown with a short header. The header is
# deliberately NOT YAML: it is a handful of `key: value` lines and indented
# `- item` lists, so that there is nothing to learn and nothing to escape. The
# body is ordinary prose, and `publish` turns the whole thing into the signed
# JSON that actually gets stored.
# --------------------------------------------------------------------------

ENUM_KEYS = {"type", "provenance", "confidence", "status"}
DRAFT_KEYS = {"type", "title", "author", "provenance", "model", "confidence",
              "status", "links", "file", "checked", "reviews", "agrees",
              "ballot", "session"}

WHAT_WAS_TRIED_RE = re.compile(r"^#{1,6}\s*what\s+was\s+tried\s*$", re.IGNORECASE)
HEADING_RE = re.compile(r"^#{1,6}\s+\S")


def parse_draft(text: str) -> tuple[dict, str]:
    """Split a markdown draft into its header fields and its body."""
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    lines = text.split("\n")
    while lines and not lines[0].strip():
        lines.pop(0)
    if not lines or lines[0].strip() != "---":
        raise Problem("D01", "draft", "a draft must begin with a line containing "
                                      "exactly three dashes: ---")
    close = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            close = i
            break
    if close is None:
        raise Problem("D02", "draft", "the header is never closed; put a line containing "
                                      "exactly --- after the last header field")

    header: dict = {}
    current_list = None
    for n, raw in enumerate(lines[1:close], start=2):
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if raw[0] in " \t":
            item = raw.strip()
            if not item.startswith("-"):
                raise Problem("D03", f"draft line {n}",
                              "indented header lines must be list items beginning with '- '")
            if current_list is None:
                raise Problem("D04", f"draft line {n}",
                              "this list item has no field name above it")
            header[current_list].append(item[1:].strip())
            continue
        if ":" not in raw:
            raise Problem("D05", f"draft line {n}",
                          f"expected 'field: value', got {raw.strip()!r}")
        key, _, value = raw.partition(":")
        key, value = key.strip(), value.strip()
        if key not in DRAFT_KEYS:
            raise Problem("D06", f"draft line {n}",
                          f"unknown header field {key!r}. Known fields: "
                          + ", ".join(sorted(DRAFT_KEYS)))
        if value:
            if key in ENUM_KEYS:
                value = value.split("#", 1)[0].strip()
            header[key] = value
            current_list = None
        else:
            header[key] = []
            current_list = key

    body = "\n".join(lines[close + 1:]).strip("\n")
    return header, body


def split_what_was_tried(body: str) -> tuple[str, str]:
    """Pull a '## What was tried' section out of the body into its own field."""
    lines = body.split("\n")
    start = next((i for i, l in enumerate(lines) if WHAT_WAS_TRIED_RE.match(l.strip())), None)
    if start is None:
        return body, ""
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if HEADING_RE.match(lines[j].strip()):
            end = j
            break
    section = "\n".join(lines[start + 1:end]).strip("\n")
    rest = "\n".join(lines[:start] + lines[end:]).strip("\n")
    return rest, section


def _artifact_entry(corpus: Corpus, rel: str) -> dict:
    """Turn a path the author typed into a path plus a fingerprint we computed."""
    rel = rel.strip()
    if rel.startswith("/") or ".." in Path(rel).parts:
        raise Problem("D07", "draft", f"artifact path {rel!r} must be relative, inside artifacts/")
    fp = corpus.artifacts_dir / rel
    if not fp.is_file():
        raise Problem("D08", "draft", f"no such file: artifacts/{rel}")
    return {"path": rel, "sha256": file_hash(fp)}


def draft_to_record(header: dict, body: str, corpus: Corpus, default_author: str) -> dict:
    def one(key):
        v = header.get(key)
        if isinstance(v, list):
            raise Problem("D09", "draft", f"{key} takes a single value, not a list")
        return v

    rtype = one("type")
    if not rtype:
        raise Problem("D10", "draft", "the header must say what type of record this is")
    if rtype not in RECORD_TYPES:
        raise Problem("D11", "draft", f"unknown type {rtype!r}. One of: "
                                      + ", ".join(sorted(RECORD_TYPES)))
    title = one("title")
    if not title:
        raise Problem("D12", "draft", "the header must give a title")
    author = one("author") or default_author
    if not author:
        raise Problem("D13", "draft", "no author: put one in the header, or run "
                                      "`polymath init --handle <you>`")

    rec = _template(rtype, author)
    rec["title"] = title

    if rtype == "obstruction":
        body, tried = split_what_was_tried(body)
        if PLACEHOLDER in tried:
            raise Problem("D24", "draft",
                          "the 'What was tried' section still contains " + PLACEHOLDER)
        rec["what_was_tried"] = tried
        if not tried:
            raise Problem("D14", "draft",
                          "an obstruction needs a '## What was tried' section. That section "
                          "is what makes 'several people hit this same wall' findable later")
    elif "what_was_tried" in rec:
        del rec["what_was_tried"]

    if not body.strip():
        raise Problem("D15", "draft", "the body is empty")
    leftover = [f for f in (body, rec.get("what_was_tried", "")) if PLACEHOLDER in f]
    if leftover:
        raise Problem("D24", "draft",
                      "the draft still contains " + PLACEHOLDER + ". Replace every such "
                      "paragraph with your own words (or delete the section) before "
                      "publishing")
    rec["body"] = body

    kind = one("provenance") or "human"
    if kind not in PROVENANCE_KINDS:
        raise Problem("D16", "draft", f"provenance must be one of: "
                                      + ", ".join(sorted(PROVENANCE_KINDS)))
    rec["provenance"] = {"kind": kind, "model": one("model")}

    if one("confidence"):
        rec["asserted_confidence"] = one("confidence")
    elif "asserted_confidence" in rec and rtype not in ("conjecture", "argument", "counterexample"):
        del rec["asserted_confidence"]
    if one("status"):
        rec["status"] = one("status")
    if one("session"):
        rec["session"] = one("session")

    links = []
    for item in header.get("links", []) or []:
        parts = item.split()
        if len(parts) != 2:
            raise Problem("D17", "draft",
                          f"each link is a relation and a record id, e.g. "
                          f"'- depends_on 0123456789ab-some-slug'; got {item!r}")
        links.append({"rel": parts[0], "target": parts[1]})
    rec["links"] = links

    if rtype == "artifact":
        if not one("file"):
            raise Problem("D18", "draft", "an artifact record needs 'file: <path under artifacts/>'")
        rec["file"] = _artifact_entry(corpus, one("file"))
    if rtype == "verdict":
        paths = header.get("checked") or ([one("checked")] if one("checked") else [])
        if not paths:
            raise Problem("D19", "draft",
                          "a verdict must list what it checked, so it cannot stay valid "
                          "over later edits. Use a 'checked:' list of paths under artifacts/")
        rec["checked"] = [_artifact_entry(corpus, x) for x in paths]
    if rtype == "statement_review":
        if not one("reviews"):
            raise Problem("D20", "draft", "a statement review needs 'reviews: <verdict id>'")
        rec["reviews"] = one("reviews")
    if rtype == "agreement":
        parts = (one("agrees") or "").split()
        if len(parts) != 3:
            raise Problem("D21", "draft",
                          "an agreement needs 'agrees: <source id> <relation> <target id>'")
        rec["agrees"] = {"source": parts[0], "rel": parts[1], "target": parts[2]}
    if rtype == "vote":
        if not one("ballot"):
            raise Problem("D22", "draft", "a vote needs a 'ballot:' field")
        rec["ballot"] = one("ballot")

    for k in list(rec):
        if rec[k] == {} and k in REQUIRED_BY_TYPE.get(rtype, []):
            raise Problem("D23", "draft", f"a {rtype} record needs a {k!r} field")
    return rec



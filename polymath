def draft_template(rtype: str, author: str, title: str = "") -> str:
    """The file a person edits: a generated header they can ignore, and prose
    sections with placeholders they overwrite.

    Deliberately no `links:` block. Nobody should have to know the syntax, or
    choose between nine relation names; connections are made by being asked at
    publish time instead.
    """
    h = ["type: " + rtype, "title: " + title, "author: " + author, "provenance: human"]
    if rtype in ("question", "conjecture"):
        h.append("status: open")
    if rtype in ("conjecture", "argument", "counterexample"):
        h.append("confidence: plausible")
    if rtype == "artifact":
        h.append("file: your-file.json")
    if rtype == "verdict":
        h += ["checked:", "  - your-file.json"]
    if rtype == "statement_review":
        h.append("reviews:")
    if rtype == "agreement":
        h.append("agrees:")

    # The guidance lives in the header, where lines beginning with # are stripped
    # out automatically. Putting it in the body would mean a person who did not
    # delete it published it by accident.
    h += ["#",
          "# Everything above was written for you. You can ignore it.",
          "#",
          "# Below the second line of dashes, replace each " + PLACEHOLDER,
          "# paragraph with your own words. Plain prose is all that is needed:",
          "# no formatting is required, and nothing has to be escaped.",
          "# Leave the ## headings alone -- they are what make the sections",
          "# searchable. Delete a whole section if it does not apply.",
          "#"]
    out = ["---"] + h + ["---", ""]
    for heading, guidance in BODY_TEMPLATES.get(rtype, [("Body", "Write here.")]):
        out += ["## " + heading, "", PLACEHOLDER + ". " + guidance, ""]
    return "\n".join(out) + "\n"

def _template(rtype: str, author: str) -> dict:
    rec = {
        "schema": SCHEMA,
        "type": rtype,
        "title": "",
        "body": "",
        "author": author,
        "provenance": {"kind": "human", "model": None},
        "links": [],
    }
    if rtype in ("question", "conjecture"):
        rec["status"] = "open"
    if rtype in ("conjecture", "argument", "counterexample"):
        rec["asserted_confidence"] = "plausible"
    if rtype == "obstruction":
        rec["what_was_tried"] = ""
    for f in REQUIRED_BY_TYPE.get(rtype, []):
        rec[f] = {} if f != "checked" else []
    return rec


def open_in_editor(path: Path) -> str:
    """Open the draft. $VISUAL and $EDITOR are usually unset in a terminal started
    from the desktop, so fall back to whatever the system uses for the file."""
    for var in ("VISUAL", "EDITOR"):
        prog = os.environ.get(var)
        if prog:
            try:
                subprocess.run(prog.split() + [str(path)], check=False)
                return f"opened in {prog} (from ${var})"
            except OSError:
                pass
    opener = "open" if sys.platform == "darwin" else "xdg-open"
    if shutil.which(opener):
        subprocess.run([opener, str(path)], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return "opened in your usual editor for this kind of file"
    return ""


def ask_type() -> str:
    print("What kind of record is this?\n")
    for n, (name, blurb) in enumerate(TYPE_HELP, start=1):
        print(f"  {n:>2}  {name:<18} {blurb}")
    while True:
        try:
            answer = input("\nNumber, or the name: ").strip()
        except EOFError:
            die("no answer given")
        if answer.isdigit() and 1 <= int(answer) <= len(TYPE_HELP):
            return TYPE_HELP[int(answer) - 1][0]
        if answer in RECORD_TYPES:
            return answer
        print("Not one of those. Try again.")


def cmd_new(args):
    corpus = Corpus.find(Path(args.root) if args.root else None)
    cfg = read_config(corpus)
    author = args.author or cfg.get("handle") or ""

    rtype = args.type
    if not rtype:
        rtype = ask_type()
    elif rtype not in RECORD_TYPES:
        die(f"unknown type {rtype!r}; one of: {', '.join(sorted(RECORD_TYPES))}")

    title = args.title
    if not title:
        try:
            title = input("\nOne-line title: ").strip()
        except EOFError:
            title = ""
        if not title:
            die("a title is needed; you can pass it with --title next time")

    if args.json:
        rec = _template(rtype, author)
        rec["title"] = title
        out = Path(args.out) if args.out else Path(f"draft-{rtype}.json")
        out.write_text(json.dumps(rec, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    else:
        out = Path(args.out) if args.out else Path(f"draft-{rtype}.md")
        out.write_text(draft_template(rtype, author, title), encoding="utf-8")

    print(f"\nCreated {out}")
    print("It already contains everything except the prose. Replace each")
    print(f"'{PLACEHOLDER}' paragraph with your own words.")
    if not args.no_edit and not args.out:
        note = open_in_editor(out)
        if note:
            print(note)
    print(f"\nWhen you have finished writing:  polymath publish {out}")
    if not author:
        print("\nNo handle configured yet. Fill in the author field, or run "
              "`polymath init --handle <you>`.")
    return 0


def read_config(corpus: Corpus) -> dict:
    f = corpus.root / ".polymath.json"
    if f.exists():
        try:
            return json.loads(f.read_text(encoding="utf-8"))
        except Exception:
            return {}
    return {}


def cmd_init(args):
    root = Path(args.root or ".").resolve()
    for d in ("people", "records", "artifacts", "transcripts", "LICENSES"):
        (root / d).mkdir(parents=True, exist_ok=True)
    cfg_path = root / ".polymath.json"
    cfg = json.loads(cfg_path.read_text()) if cfg_path.exists() else {}
    if args.handle:
        cfg["handle"] = args.handle
    if args.key:
        cfg["key"] = str(Path(args.key).expanduser())
    cfg_path.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    gi = root / ".gitignore"
    if not gi.exists():
        gi.write_text(".polymath.json\ndraft-*.json\n", encoding="utf-8")
    print(f"initialised corpus at {root}")
    if not cfg.get("handle") or not cfg.get("key"):
        print("Set your identity with:  polymath init --handle <you> --key ~/.ssh/id_ed25519")
    return 0


def _finalise(rec: dict, key_path: Path) -> dict:
    rec.pop("id", None)
    rec.pop("signature", None)
    rec = nfc(rec)
    rec["id"] = make_id(rec)
    rec["signature"] = ssh_sign(canonical_bytes(rec), key_path)
    return rec


LINK_CHOICES = [
    ("answers", "It answers an open question"),
    ("depends_on", "It bears on, or depends on, something"),
    ("supports", "It supports a conjecture or a theorem"),
    ("specializes", "It is the same thing, restricted to a special case"),
    ("generalizes", "It is a more general version of something"),
    ("variant_of", "It is the same thing in a different setting -- a sideways move, "
                   "where neither one implies the other"),
    ("refutes", "It contradicts a conjecture or a theorem"),
    ("duplicates", "It says the same thing as something already there"),
    ("proved_in", "It is proved in a paper or book already recorded here"),
    ("cites", "It just refers to something"),
]


def ask_links(corpus: Corpus) -> list:
    """Ask, in plain questions, what this connects to. The person never sees a
    relation name or types an identifier."""
    links = []
    while True:
        print("\nDoes this connect to anything already in the record?\n")
        for n, (_, blurb) in enumerate(LINK_CHOICES, start=1):
            print(f"  {n}  {blurb}")
        print("  0  Nothing" + (" else" if links else "") + " -- carry on")
        try:
            answer = input("\n> ").strip()
        except EOFError:
            return links
        if answer in ("", "0"):
            return links
        if not (answer.isdigit() and 1 <= int(answer) <= len(LINK_CHOICES)):
            print("Not one of those.")
            continue
        rel = LINK_CHOICES[int(answer) - 1][0]
        if rel in TARGET_RELS:
            print("\nNote: saying this about somebody else's record is visible to")
            print("everyone straight away, but it does not take effect until they")
            print("agree to it. That is deliberate.")
        try:
            words = input("\nWhich one? Type a few words to find it:\n> ").strip()
        except EOFError:
            return links
        if not words:
            continue
        hits = search_records(corpus, words.split())[:9]
        if not hits:
            print("Nothing matched. Try different words, or 0 to skip.")
            continue
        print()
        for n, (_, _, rec) in enumerate(hits, start=1):
            print(f"  {n}  {rec['type']:<16} {rec.get('title', '')}")
        try:
            pick = input("\n> ").strip()
        except EOFError:
            return links
        if not (pick.isdigit() and 1 <= int(pick) <= len(hits)):
            print("Skipped.")
            continue
        target = hits[int(pick) - 1][2]
        links.append({"rel": rel, "target": target["id"]})
        print(f"Linked to: {target.get('title', '')}")


def remote_compare_url(root: str, branch: str) -> str:
    r = subprocess.run(["git", "-C", root, "remote", "get-url", "origin"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return ""
    url = r.stdout.strip()
    m = re.match(r"(?:git@([^:]+):|https?://(?:[^@]+@)?([^/]+)/)(.+?)(?:\.git)?/?$", url)
    if not m:
        return ""
    host = m.group(1) or m.group(2)
    path = m.group(3)
    base = subprocess.run(["git", "-C", root, "symbolic-ref", "--short",
                           "refs/remotes/origin/HEAD"],
                          capture_output=True, text=True).stdout.strip()
    base = base.split("/")[-1] or "main"
    return f"https://{host}/{path}/compare/{base}...{branch}?expand=1"


def git_carry_through(corpus: Corpus, rec: dict, paths: list, open_browser=True) -> int:
    """Record the change in the history and offer it to the project.

    A 'pull request' is a proposal: your change sits where somebody else can read
    it, and only becomes part of the shared record once they agree.
    """
    import webbrowser
    root = str(corpus.root)

    def git(*a, check=True):
        r = subprocess.run(["git", "-C", root, *a], capture_output=True, text=True)
        if check and r.returncode != 0:
            print(f"\ngit {' '.join(a)} failed:\n  {r.stderr.strip()}", file=sys.stderr)
            raise SystemExit(1)
        return r

    if not (corpus.root / ".git").exists():
        print("\nThis folder is not tracked by git, so the record exists only here.")
        return 0

    branch = "record/" + rec["id"].split("-", 1)[0]
    if git("rev-parse", "--verify", branch, check=False).returncode == 0:
        branch += "-" + _dt.datetime.now().strftime("%H%M%S")
    git("checkout", "-q", "-b", branch)
    for pth in paths:
        git("add", "--", str(pth))
    subject = f"{rec['type']}: {rec['title']}"[:72]
    r = git("commit", "-q", "-s", "-m", subject, check=False)
    if r.returncode != 0:
        print("\nCould not record the change:\n  " + (r.stderr or r.stdout).strip(),
              file=sys.stderr)
        print("(If it says your name or email is unset, run:\n"
              "   git config --global user.name \"Your Name\"\n"
              "   git config --global user.email you@example.edu)", file=sys.stderr)
        return 1
    print(f"\nRecorded in the history on a new branch: {branch}")

    if git("remote", "get-url", "origin", check=False).returncode != 0:
        print("\nThere is no shared server configured for this copy, so that is as far")
        print("as it goes for now: the record is saved and committed on your machine.")
        return 0

    r = git("push", "-q", "-u", "origin", branch, check=False)
    if r.returncode != 0:
        print("\nCould not send it to the server:\n  " + r.stderr.strip(), file=sys.stderr)
        print("Your work is safe locally. Fix the problem and run:\n"
              f"   git push -u origin {branch}", file=sys.stderr)
        return 1
    print("Sent to the shared server.")

    url = remote_compare_url(root, branch)
    if not url:
        print("Now open a pull request for that branch on the project's web page.")
        return 0
    print("\nThe last step is a PULL REQUEST: a proposal that somebody other than")
    print("you reads and agrees to before it joins the shared record. Opening the")
    print("page for you now -- the form is already filled in; press the green button.")
    print(f"\n  {url}")
    if open_browser:
        try:
            webbrowser.open(url)
        except Exception:
            pass
    return 0


def cmd_publish(args):
    corpus = Corpus.find(Path(args.root) if args.root else None)
    cfg = read_config(corpus)
    src = Path(args.draft)
    if not src.is_file():
        die(f"no such draft: {src}")
    text = src.read_text(encoding="utf-8")
    if src.suffix.lower() in (".md", ".markdown", ".txt") or text.lstrip().startswith("---"):
        header, body = parse_draft(text)
        if args.author:
            header["author"] = args.author
        rec = draft_to_record(header, body, corpus, cfg.get("handle", ""))
    else:
        rec = json.loads(text)
        if args.author:
            rec["author"] = args.author
    key = Path(args.key or cfg.get("key", "")).expanduser()
    if not key or not key.exists():
        die("no signing key configured; run `polymath init --key ~/.ssh/id_ed25519`")

    # Connections are asked for here, not written by hand in the file.
    if not rec.get("links") and not args.yes and not args.no_links and corpus.records:
        rec["links"] = ask_links(corpus)
    rec = _finalise(rec, key)

    dest = corpus.record_dir_for()
    dest.mkdir(parents=True, exist_ok=True)
    target = dest / f"{rec['id']}.json"

    has_remote = (corpus.root / ".git").exists() and subprocess.run(
        ["git", "-C", str(corpus.root), "remote", "get-url", "origin"],
        capture_output=True).returncode == 0
    will_push = has_remote and not args.local_only

    print("=" * 72)
    print("About to publish, under your name, permanently:")
    print("=" * 72)
    print(f"  kind    {rec['type']}")
    print(f"  author  {rec['author']}")
    print(f"  title   {rec['title']}")
    print("-" * 72)
    # Never abbreviate. This screen is the human backstop against content that
    # should not go out, and anything hidden here is exactly where a payload
    # would be put. A record is capped at MAX_BODY characters precisely so that
    # showing all of it is always reasonable.
    print(rec["body"])
    if rec.get("what_was_tried"):
        print("-" * 72)
        print("What was tried:")
        print(rec["what_was_tried"])
    print("-" * 72)
    for extra in ("file", "checked", "reviews", "agrees", "ballot"):
        if rec.get(extra):
            print(f"  {extra:<8} {json.dumps(rec[extra], ensure_ascii=False)}")
    if rec.get("links"):
        for l in rec["links"]:
            tgt = corpus.records.get(l["target"], {})
            kind = "takes effect at once" if l["rel"] in SOURCE_RELS else "until they agree, advisory"
            print(f"  link     {l['rel']} -> {tgt.get('title', l['target'])}  ({kind})")
    else:
        print("  link     none -- nothing links to this and it links to nothing,")
        print("           so nobody will come across it by following anything")
    print("-" * 72)
    print("What will happen:")
    print(f"  1. the record is written to {target.relative_to(corpus.root)}")
    print("  2. it is checked against every rule")
    if (corpus.root / ".git").exists():
        print("  3. it is signed with your key and recorded in the history")
    if will_push:
        print("  4. it is sent to the shared server")
        print("  5. your browser opens so you can propose it for review")
        print("\nAfter step 4 it is public and permanent. Nothing is ever deleted.")
    elif has_remote:
        print("  (--local-only: it will not be sent anywhere)")
    else:
        print("  (no shared server configured, so it stays on this machine)")
    print("-" * 72)
    print("Read the text above as if a stranger wrote it. If an assistant helped,")
    print("it may have been influenced by material other people wrote.")
    print("=" * 72)
    if not args.yes:
        try:
            if input("Publish? [y/N] ").strip().lower() not in ("y", "yes"):
                print("Not published. Your draft is untouched.")
                return 1
        except EOFError:
            print("Not published.")
            return 1

    target.write_text(json.dumps(rec, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    corpus._records = None
    rel = str(target.relative_to(corpus.root))
    problems = [p for p in run_validation(corpus) if p.where == rel]
    if problems:
        target.unlink()
        for p in problems:
            print(str(p), file=sys.stderr)
        die("the record does not pass the checks; nothing was written")
    print(f"\nWritten to {rel}")

    paths = [target]
    if rec.get("type") == "artifact" and isinstance(rec.get("file"), dict):
        paths.append(corpus.artifacts_dir / rec["file"]["path"])
    if rec.get("type") == "verdict":
        paths += [corpus.artifacts_dir / c["path"] for c in rec.get("checked", [])]
    if args.local_only:
        print("(--local-only, so it has not been committed or sent anywhere.)")
        return 0
    return git_carry_through(corpus, rec, paths, open_browser=not args.no_browser)



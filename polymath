#!/usr/bin/env python3
"""polymath -- Stage 0 client for a shared, public, signed mathematical record.

Stage 0 contains no AI component. It is the record format, the signatures, the
validator, and enough search to answer "has this been tried?".

Dependencies: Python 3.11+ and the `ssh-keygen` program. Nothing else.

The validator in this file is the authority: the same code runs on your machine
(`polymath validate`) and in the automatic checks on every proposed change. Anything
this file does that the validator cannot re-check afterwards is a convenience for
honest members, not a control. See polymath_design_v3.md section 3.
"""

from __future__ import annotations

import argparse
import datetime as _dt
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
import unicodedata
from pathlib import Path

SCHEMA = 1
SIG_NAMESPACE = "polymath-record"
MAX_BODY = 4000
MAX_TITLE = 200
MAX_JSON_DEPTH = 32
MAX_ARTIFACT_BYTES = 10 * 1024 * 1024
TOP_LEVEL = {"people", "records", "artifacts", "transcripts", "LICENSES",
             "tests", ".github", "polymath", "README.md", ".gitignore",
             ".polymath.json", ".polymath-state.json", ".polymath-browse.html"}

RECORD_TYPES = {
    "question", "conjecture", "theorem", "argument", "obstruction", "counterexample",
    "artifact", "note", "reference", "verdict", "statement_review",
    "vote", "agreement",
}

# Links asserting something about the record that contains them. The author wrote
# the record, so these are binding for that record's own status with no further
# agreement needed.
SOURCE_RELS = {"depends_on", "cites", "proved_in", "answers", "supports",
               "generalizes", "specializes", "variant_of"}
# Links asserting something about somebody else's record. Advisory until the
# target's author publishes an `agreement` record. `supersedes` is special: only
# an author may supersede their own record, which the validator enforces directly.
TARGET_RELS = {"refutes", "duplicates", "supersedes"}
ALL_RELS = SOURCE_RELS | TARGET_RELS

CONFIDENCE = {"speculative", "plausible", "confident"}
STATUSES = {"open", "resolved", "retired"}
PROVENANCE_KINDS = {"human", "agent-assisted", "agent-authored"}

HANDLE_RE = re.compile(r"\A[a-z][a-z0-9_-]{1,31}\Z")
SLUG_RE = re.compile(r"\A[a-z0-9]([a-z0-9-]{0,46}[a-z0-9])?\Z")
ID_RE = re.compile(r"\A([0-9a-f]{12})-([a-z0-9][a-z0-9-]{0,46})\Z")

# Characters that must never appear in corpus content.
BIDI = {"‪", "‫", "‬", "‭", "‮",
        "⁦", "⁧", "⁨", "⁩", "‏", "‎"}
# Only real tag syntax counts. Mathematicians write <a,b | a^2>, <a> for the
# cyclic group generated by a, and "2 < a and b > 1" constantly, and all of those
# must pass. Two cases are dangerous:
#   * a bare tag that does something on its own (a script, an embedded frame);
#   * any tag carrying an attribute, which is how a URL gets in.
# A bare <a> or <img> with no attributes does nothing at all, so it is allowed,
# which is what lets <a> mean a cyclic group.
_ACTIVE = r"script|iframe|object|embed|svg|style|form|meta|link"
_ANY = r"script|iframe|img|object|embed|svg|style|link|meta|a|div|span|form|input"
HTML_RE = re.compile(
    rf"<\s*/?\s*(?:{_ACTIVE})\s*/?>"
    rf"|<\s*(?:{_ANY})\s+[A-Za-z][A-Za-z0-9-]*\s*=",
    re.IGNORECASE)
REMOTE_IMG_RE = re.compile(r"!\[[^\]]*\]\(\s*(https?:|//)", re.IGNORECASE)
LFS_RE = re.compile(rb"\Aversion https://git-lfs\.github\.com/spec/")

REQUIRED_BY_TYPE = {
    "verdict": ["checked"],          # fingerprints of exactly what was checked
    "statement_review": ["reviews"],  # the verdict being attested
    "agreement": ["agrees"],          # the (source, rel, target) being agreed to
    "artifact": ["file"],             # path + fingerprint of the attached file
    "vote": ["ballot"],
}


# --------------------------------------------------------------------------
# errors
# --------------------------------------------------------------------------

class Problem(Exception):
    """A validation failure, reported with a stable code so tests can assert on it."""

    def __init__(self, code: str, where: str, detail: str):
        super().__init__(f"[{code}] {where}: {detail}")
        self.code, self.where, self.detail = code, where, detail


def die(msg: str, status: int = 1):
    print(f"polymath: {msg}", file=sys.stderr)
    raise SystemExit(status)


# --------------------------------------------------------------------------
# canonical form, hashing, identifiers
# --------------------------------------------------------------------------

def nfc(x):
    """Normalise text so that two visually identical strings hash identically."""
    if isinstance(x, str):
        return unicodedata.normalize("NFC", x)
    if isinstance(x, list):
        return [nfc(i) for i in x]
    if isinstance(x, dict):
        return {nfc(k): nfc(v) for k, v in x.items()}
    return x


def canonical_bytes(record: dict) -> bytes:
    """The exact bytes that get hashed and signed.

    `id` and `signature` are excluded: the identifier is derived from this, and the
    signature is computed over it, so neither can be part of its own input.
    """
    payload = {k: v for k, v in record.items() if k not in ("id", "signature")}
    payload = nfc(payload)
    return json.dumps(payload, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False).encode("utf-8")


def content_hash(record: dict) -> str:
    return hashlib.sha256(canonical_bytes(record)).hexdigest()[:12]


def slugify(title: str) -> str:
    s = unicodedata.normalize("NFKD", title).encode("ascii", "ignore").decode()
    s = re.sub(r"[^a-zA-Z0-9]+", "-", s).strip("-").lower()
    s = re.sub(r"-{2,}", "-", s)[:47].strip("-")
    return s or "untitled"


def make_id(record: dict) -> str:
    return f"{content_hash(record)}-{slugify(record.get('title', ''))}"


def file_hash(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def json_depth(obj, d=0):
    if d > MAX_JSON_DEPTH:
        return d
    if isinstance(obj, dict):
        return max([d] + [json_depth(v, d + 1) for v in obj.values()])
    if isinstance(obj, list):
        return max([d] + [json_depth(v, d + 1) for v in obj])
    return d


# --------------------------------------------------------------------------
# corpus
# --------------------------------------------------------------------------

class Corpus:
    def __init__(self, root: Path):
        self.root = root.resolve()
        self.people_dir = self.root / "people"
        self.records_dir = self.root / "records"
        self.artifacts_dir = self.root / "artifacts"
        self._people = None
        self._records = None

    # -- discovery ---------------------------------------------------------

    @classmethod
    def find(cls, start: Path | None = None) -> "Corpus":
        p = (start or Path.cwd()).resolve()
        for cand in [p, *p.parents]:
            if (cand / "people").is_dir() and (cand / "records").is_dir():
                return cls(cand)
        die("not inside a polymath corpus (no people/ and records/ found above here)")

    # -- people ------------------------------------------------------------

    @property
    def people(self) -> dict:
        if self._people is None:
            self._people = {}
            if self.people_dir.is_dir():
                for f in sorted(self.people_dir.glob("*.toml")):
                    try:
                        data = tomllib.loads(f.read_text(encoding="utf-8"))
                    except Exception as e:
                        raise Problem("P01", str(f.name), f"unreadable member file: {e}")
                    data["_file"] = f
                    self._people[f.stem] = data
        return self._people

    def active_keys(self, handle: str) -> list[str]:
        """Public keys currently valid for a member, i.e. not revoked."""
        person = self.people.get(handle)
        if not person:
            return []
        revoked = {r.get("key", "").strip()
                   for r in person.get("revocation", [])}
        return [k.strip() for k in person.get("keys", [])
                if k.strip() and k.strip() not in revoked]

    def admins(self) -> set[str]:
        return {h for h, p in self.people.items() if p.get("role") == "admin"}

    def allowed_signers(self) -> str:
        lines = []
        for handle in sorted(self.people):
            for key in self.active_keys(handle):
                parts = key.split()
                if len(parts) >= 2:
                    lines.append(f"{handle} {parts[0]} {parts[1]}")
        return "\n".join(lines) + "\n"

    # -- records -----------------------------------------------------------

    def record_paths(self) -> list[Path]:
        if not self.records_dir.is_dir():
            return []
        return sorted(p for p in self.records_dir.rglob("*.json") if p.is_file())

    @property
    def records(self) -> dict:
        if self._records is None:
            self._records = {}
            for p in self.record_paths():
                try:
                    r = json.loads(p.read_text(encoding="utf-8"))
                except Exception:
                    continue
                if isinstance(r, dict) and isinstance(r.get("id"), str):
                    r["_path"] = p
                    self._records[r["id"]] = r
        return self._records

    def record_dir_for(self, when: _dt.datetime | None = None) -> Path:
        when = when or _dt.datetime.now(_dt.timezone.utc)
        return self.records_dir / f"{when:%Y}" / f"{when:%m}"


# --------------------------------------------------------------------------
# signing
# --------------------------------------------------------------------------

def ssh_sign(data: bytes, key_path: Path) -> str:
    if not key_path.exists():
        die(f"signing key not found: {key_path}")
    r = subprocess.run(["ssh-keygen", "-Y", "sign", "-f", str(key_path),
                        "-n", SIG_NAMESPACE, "-"],
                       input=data, capture_output=True)
    if r.returncode != 0:
        die(f"ssh-keygen could not sign: {r.stderr.decode(errors='replace').strip()}")
    return r.stdout.decode()


def ssh_verify(data: bytes, signature: str, handle: str, allowed: str) -> bool:
    with tempfile.TemporaryDirectory() as td:
        td = Path(td)
        (td / "allowed").write_text(allowed, encoding="utf-8")
        (td / "sig").write_text(signature, encoding="utf-8")
        r = subprocess.run(
            ["ssh-keygen", "-Y", "verify", "-f", str(td / "allowed"),
             "-I", handle, "-n", SIG_NAMESPACE, "-s", str(td / "sig")],
            input=data, capture_output=True)
        return r.returncode == 0


# --------------------------------------------------------------------------
# validation
# --------------------------------------------------------------------------

# Everything in this corpus is published permanently and mirrored by every member,
# so a path or an address that leaks out cannot be retracted. These are the things
# that most often travel by accident from a working directory into a public record.
LEAK_PATTERNS = [
    (re.compile(r"(?:/Users|/home)/[A-Za-z0-9._-]+"),
     "an absolute path containing somebody's account name"),
    (re.compile(r"(?<![\w.])~/[A-Za-z0-9._][A-Za-z0-9._/ -]*"),
     "a path inside somebody's home directory"),
    (re.compile(r"/Volumes/[A-Za-z0-9._ -]+"), "a path on a mounted disk"),
    (re.compile(r"[A-Za-z]:\\Users\\[A-Za-z0-9._-]+"), "a Windows account path"),
    (re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"), "an email address"),
]


# Generic paths that are instructions rather than disclosures: they name no person
# and no project, and documentation has to be able to say them.
LEAK_ALLOWED = re.compile(r"\A~/\.(ssh|config|gitconfig|zshrc|bashrc|local|cache)\b")


def check_leaks(value: str, where: str, field: str):
    for pattern, description in LEAK_PATTERNS:
        for m in pattern.finditer(value):
            if LEAK_ALLOWED.match(m.group(0)):
                continue
            raise Problem("C07", where,
                          f"{field} contains {description} ({m.group(0)!r}). Everything "
                          f"here is published permanently and mirrored by every member, "
                          f"so it cannot be taken back. Describe the location instead of "
                          f"giving the path")
            break


def check_text(value: str, where: str, field: str):
    """Reject characters that make displayed text differ from actual text."""
    for ch in value:
        if ch in BIDI:
            raise Problem("C02", where,
                          f"{field} contains a text-direction override character "
                          f"(U+{ord(ch):04X}); these make a line display differently "
                          f"from what it says")
        cat = unicodedata.category(ch)
        if cat == "Cc" and ch not in "\n\t":
            raise Problem("C01", where,
                          f"{field} contains control character U+{ord(ch):04X}")
        if cat == "Cf":
            raise Problem("C03", where,
                          f"{field} contains invisible formatting character U+{ord(ch):04X}")
    if value != unicodedata.normalize("NFC", value):
        raise Problem("C04", where, f"{field} is not in normalised (NFC) form")


def walk_strings(obj, where: str, path: str = ""):
    if isinstance(obj, str):
        check_text(obj, where, path or "field")
    elif isinstance(obj, dict):
        for k, v in obj.items():
            check_text(str(k), where, f"{path}.{k} (key)")
            walk_strings(v, where, f"{path}.{k}")
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            walk_strings(v, where, f"{path}[{i}]")


def validate_record(rec: dict, path: Path, corpus: Corpus, problems: list):
    where = str(path.relative_to(corpus.root))

    def bad(code, detail):
        problems.append(Problem(code, where, detail))

    # -- shape ---------------------------------------------------------
    if rec.get("schema") != SCHEMA:
        bad("S01", f"unknown schema version {rec.get('schema')!r} (this client knows {SCHEMA})")
        return
    if json_depth(rec) > MAX_JSON_DEPTH:
        bad("S02", "structure nested too deeply")
        return
    rtype = rec.get("type")
    if rtype not in RECORD_TYPES:
        bad("S03", f"unknown record type {rtype!r}")
        return
    for field in ("title", "body", "author", "id", "signature"):
        if not isinstance(rec.get(field), str) or not rec[field]:
            bad("S04", f"missing or empty required field {field!r}")
            return
    for field in REQUIRED_BY_TYPE.get(rtype, []):
        if field not in rec:
            bad("S05", f"a {rtype} record must have a {field!r} field")
    if len(rec["title"]) > MAX_TITLE:
        bad("S06", f"title is {len(rec['title'])} characters (limit {MAX_TITLE})")
    if len(rec["body"]) > MAX_BODY:
        bad("S07", f"body is {len(rec['body'])} characters (limit {MAX_BODY}); "
                   f"longer material belongs in an artifact")
    if rec.get("status") is not None and rec.get("status") not in STATUSES:
        bad("S08", f"unknown status {rec.get('status')!r}")
    if rec.get("asserted_confidence") is not None and rec["asserted_confidence"] not in CONFIDENCE:
        bad("S09", f"unknown asserted_confidence {rec['asserted_confidence']!r}; note there is "
                   f"deliberately no 'verified' value -- verification is computed, never asserted")
    if "confidence" in rec:
        bad("S10", "the field 'confidence' does not exist; use 'asserted_confidence', and note "
                   "that verified status is computed from verdict and statement_review records")
    prov = rec.get("provenance")
    if not isinstance(prov, dict) or prov.get("kind") not in PROVENANCE_KINDS:
        bad("S11", "provenance must record whether this was written by a person, with an "
                   "assistant's help, or by an assistant")
    elif prov["kind"] != "human" and not prov.get("model"):
        bad("S12", "provenance says an assistant was involved, so it must name the model")

    # -- content -------------------------------------------------------
    try:
        walk_strings({k: v for k, v in rec.items() if k != "signature"}, where)
    except Problem as p:
        problems.append(p)
    for field in ("title", "body", "what_was_tried"):
        if isinstance(rec.get(field), str):
            try:
                check_leaks(rec[field], where, field)
            except Problem as leak:
                problems.append(leak)
    if HTML_RE.search(rec["body"]):
        bad("C05", "body contains raw HTML; the corpus is plain markdown so that no program "
                   "displaying it has to defend against embedded markup")
    if REMOTE_IMG_RE.search(rec["body"]):
        bad("C06", "body loads an image from another website; that reveals every reader's "
                   "address to whoever runs it. Attach the image as an artifact instead")

    # -- identity and signature ----------------------------------------
    m = ID_RE.match(rec["id"])
    if not m:
        bad("I01", f"malformed identifier {rec['id']!r}")
    else:
        want = content_hash(rec)
        if m.group(1) != want:
            bad("I02", f"identifier fingerprint is {m.group(1)} but the contents hash to {want}; "
                       f"the record has been altered since it was written")
        if m.group(2) != slugify(rec["title"]):
            bad("I03", "identifier slug does not match the title")
    if path.name != rec["id"] + ".json":
        bad("I04", f"file should be named {rec['id']}.json")
    if not HANDLE_RE.match(rec["author"]):
        bad("I05", f"malformed author handle {rec['author']!r}")
    elif rec["author"] not in corpus.people:
        bad("I06", f"author {rec['author']!r} is not a member")
    elif not corpus.active_keys(rec["author"]):
        bad("I07", f"author {rec['author']!r} has no active key")
    elif not ssh_verify(canonical_bytes(rec), rec["signature"],
                        rec["author"], corpus.allowed_signers()):
        bad("I08", "signature does not verify against any active key for this author")

    # -- links ---------------------------------------------------------
    links = rec.get("links", [])
    if not isinstance(links, list):
        bad("L01", "links must be a list")
        links = []
    for i, link in enumerate(links):
        if not isinstance(link, dict):
            bad("L02", f"link {i} is not an object")
            continue
        rel, target = link.get("rel"), link.get("target")
        if rel not in ALL_RELS:
            bad("L03", f"link {i} has unknown relation {rel!r}")
        if not isinstance(target, str) or not ID_RE.match(target):
            bad("L04", f"link {i} has malformed target {target!r}")
            continue
        if target not in corpus.records:
            bad("L05", f"link {i} points at {target}, which does not exist")
            continue
        if rel == "supersedes":
            tgt = corpus.records[target]
            if tgt.get("author") != rec["author"]:
                bad("L06", f"only {tgt.get('author')!r} may supersede their own record "
                           f"{target}; publish a note or a refutes link instead")

    if rtype == "agreement":
        ag = rec.get("agrees")
        if not isinstance(ag, dict) or not {"source", "rel", "target"} <= set(ag):
            bad("A01", "an agreement must name source, rel and target")
        elif ag["target"] in corpus.records:
            if corpus.records[ag["target"]].get("author") != rec["author"]:
                bad("A02", f"only the author of {ag['target']} may agree to a link pointing at it")
            if ag["rel"] not in TARGET_RELS:
                bad("A03", f"{ag['rel']!r} needs no agreement; it only affects the record "
                           f"that contains it")

    # -- attached files --------------------------------------------------
    if rtype == "artifact":
        spec = rec.get("file")
        if not isinstance(spec, dict) or "path" not in spec or "sha256" not in spec:
            bad("F01", "an artifact record must give the file's path and sha256 fingerprint")
        else:
            rel = str(spec["path"])
            if rel.startswith("/") or ".." in Path(rel).parts:
                bad("F02", f"artifact path {rel!r} must stay inside artifacts/")
            else:
                fp = (corpus.artifacts_dir / rel)
                try:
                    fp.resolve().relative_to(corpus.artifacts_dir)
                except ValueError:
                    bad("F03", f"artifact path {rel!r} escapes artifacts/")
                    return
                if not fp.is_file():
                    bad("F04", f"artifact file artifacts/{rel} is missing")
                elif file_hash(fp) != spec["sha256"]:
                    bad("F05", f"artifacts/{rel} does not match the fingerprint recorded here; "
                               f"a record must pin exactly the bytes it refers to")

    if rtype == "verdict":
        checked = rec.get("checked")
        if not isinstance(checked, list) or not checked:
            bad("V01", "a verdict must list the exact files it checked, with fingerprints, "
                       "so it cannot stay valid over later edits")
        else:
            for item in checked:
                if not isinstance(item, dict) or "path" not in item or "sha256" not in item:
                    bad("V02", "each checked entry needs a path and a sha256 fingerprint")


def detect_cycles(corpus: Corpus, problems: list):
    graph = {rid: [l["target"] for l in r.get("links", [])
                   if isinstance(l, dict) and l.get("rel") == "depends_on"
                   and isinstance(l.get("target"), str)]
             for rid, r in corpus.records.items()}
    WHITE, GREY, BLACK = 0, 1, 2
    colour = dict.fromkeys(graph, WHITE)

    def visit(node, stack):
        colour[node] = GREY
        for nxt in graph.get(node, []):
            if nxt not in colour:
                continue
            if colour[nxt] == GREY:
                cyc = " -> ".join(stack[stack.index(nxt):] + [nxt]) if nxt in stack else f"{node} -> {nxt}"
                problems.append(Problem("L07", "records", f"depends_on forms a cycle: {cyc}"))
                return
            if colour[nxt] == WHITE:
                visit(nxt, stack + [nxt])
        colour[node] = BLACK

    for node in list(graph):
        if colour[node] == WHITE:
            visit(node, [node])


def ignored_paths(root: Path) -> set[str]:
    """Paths git is told to ignore. These are local scratch (editor state, Python's
    __pycache__) and are not part of the corpus, so they are not validated."""
    r = subprocess.run(["git", "-C", str(root), "ls-files", "--others", "--ignored",
                        "--exclude-standard", "--directory"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return set()
    return {line.rstrip("/") for line in r.stdout.splitlines() if line.strip()}


def validate_tree(corpus: Corpus, problems: list):
    """Checks on the shape of the folder itself, independent of any record."""
    root = corpus.root
    ignored = ignored_paths(root)

    def is_ignored(rel: str) -> bool:
        parts = Path(rel).parts
        return any("/".join(parts[:i]) in ignored for i in range(1, len(parts) + 1))

    # Files git records as symbolic links can point anywhere on the reader's
    # machine, including a private key, which turns a harmless read into a theft.
    r = subprocess.run(["git", "-C", str(root), "ls-files", "-s"],
                       capture_output=True, text=True)
    tracked = []
    if r.returncode == 0:
        for line in r.stdout.splitlines():
            mode, _, rest = line.partition(" ")
            name = rest.split("\t", 1)[-1]
            tracked.append((mode, name))
            if mode == "120000":
                problems.append(Problem("T01", name, "symbolic link; not permitted anywhere "
                                                     "in the corpus"))
            if mode == "160000":
                problems.append(Problem("T02", name, "embedded sub-project; not permitted"))
    seen_links = set()
    for p in root.rglob("*"):
        if ".git" in p.parts or is_ignored(str(p.relative_to(root))):
            continue
        if p.is_symlink():
            rel = str(p.relative_to(root))
            if rel not in seen_links:
                seen_links.add(rel)
                problems.append(Problem("T01", rel, "symbolic link; not permitted anywhere "
                                                    "in the corpus"))

    if (root / ".gitmodules").exists():
        problems.append(Problem("T03", ".gitmodules", "sub-projects are not permitted"))
    if (root / ".gitattributes").exists():
        problems.append(Problem("T04", ".gitattributes",
                                "this file can hide a change from the review screen by marking "
                                "text as binary; it is administrator-controlled and absent by default"))

    # Two paths a Mac treats as the same file and Linux does not: the automatic
    # checks would then examine a different file from the one members read.
    seen = {}
    for p in root.rglob("*"):
        if ".git" in p.parts or not p.is_file():
            continue
        rel = str(p.relative_to(root))
        if is_ignored(rel):
            continue
        key = unicodedata.normalize("NFC", rel).lower()
        if key in seen and seen[key] != rel:
            problems.append(Problem("T05", rel,
                                    f"collides with {seen[key]} on a case-insensitive filesystem"))
        seen.setdefault(key, rel)

        if p.stat().st_size > MAX_ARTIFACT_BYTES:
            problems.append(Problem("T06", rel,
                                    f"file is {p.stat().st_size} bytes (limit {MAX_ARTIFACT_BYTES})"))
        if rel.split("/")[0] in ("records", "artifacts", "transcripts") \
                and p.suffix.lower() in (".md", ".txt", ".csv", ".json", ".tex", ".rst") \
                and p.stat().st_size < 2_000_000:
            try:
                text = p.read_text(encoding="utf-8")
            except (OSError, UnicodeDecodeError):
                text = ""
            try:
                check_leaks(text, rel, "this file")
            except Problem as leak:
                problems.append(leak)
        try:
            with open(p, "rb") as fh:
                if LFS_RE.match(fh.read(64)):
                    problems.append(Problem("T07", rel,
                                            "large-file placeholder; its contents live elsewhere "
                                            "and are not covered by any signature"))
        except OSError:
            pass

    for p in root.iterdir():
        if (p.name not in TOP_LEVEL and not p.name.startswith(".git")
                and not is_ignored(p.name)):
            problems.append(Problem("T08", p.name, "unexpected top-level entry"))


def validate_people(corpus: Corpus, problems: list):
    admins = corpus.admins()
    for handle, person in corpus.people.items():
        where = f"people/{handle}.toml"
        if not HANDLE_RE.match(handle):
            problems.append(Problem("P02", where, f"malformed handle {handle!r}"))
        if not person.get("name"):
            problems.append(Problem("P03", where, "missing name"))
        keys = person.get("keys")
        if not isinstance(keys, list) or not keys:
            problems.append(Problem("P04", where, "no public keys listed"))
        else:
            for k in keys:
                if not re.match(r"\A(ssh-ed25519|ssh-rsa|ecdsa-sha2-\S+) [A-Za-z0-9+/=]+", str(k).strip()):
                    problems.append(Problem("P05", where, f"malformed public key {str(k)[:24]!r}"))
        if person.get("role") not in ("member", "admin"):
            problems.append(Problem("P06", where, "role must be 'member' or 'admin'"))
        admitted = person.get("admitted_by")
        if handle not in admins or len(admins) > 1:
            if not admitted:
                problems.append(Problem("P07", where, "missing admitted_by"))
            elif admitted not in corpus.people:
                problems.append(Problem("P08", where, f"admitted_by {admitted!r} is not a member"))
            elif admitted != handle and corpus.people[admitted].get("role") != "admin":
                problems.append(Problem("P09", where, f"{admitted!r} is not an administrator"))
        if not person.get("key_confirmed_out_of_band"):
            problems.append(Problem("P10", where,
                                    "the public key must be confirmed in person, by video, or "
                                    "against an institutional page, and that recorded here"))


def run_validation(corpus: Corpus) -> list:
    problems: list = []
    try:
        corpus.people
    except Problem as p:
        return [p]
    validate_people(corpus, problems)
    validate_tree(corpus, problems)
    for path in corpus.record_paths():
        try:
            rec = json.loads(path.read_text(encoding="utf-8"))
        except Exception as e:
            problems.append(Problem("S00", str(path.relative_to(corpus.root)),
                                    f"not readable as JSON: {e}"))
            continue
        if not isinstance(rec, dict):
            problems.append(Problem("S00", str(path.relative_to(corpus.root)),
                                    "top level must be an object"))
            continue
        validate_record(rec, path, corpus, problems)
    detect_cycles(corpus, problems)
    return problems


# --------------------------------------------------------------------------
# searching, and the numbered shortlist
#
# You should never have to type a record identifier. Every command that lists
# records numbers them and remembers the list, so `polymath show 3` means "the
# third thing you were just shown".
# --------------------------------------------------------------------------

STATE_FILE = ".polymath-state.json"


def save_shortlist(corpus: Corpus, ids: list):
    try:
        (corpus.root / STATE_FILE).write_text(
            json.dumps({"shortlist": ids}, indent=2), encoding="utf-8")
    except OSError:
        pass


def load_shortlist(corpus: Corpus) -> list:
    try:
        return json.loads((corpus.root / STATE_FILE).read_text(encoding="utf-8"))["shortlist"]
    except Exception:
        return []


def resolve_id(corpus: Corpus, token: str) -> str:
    """Accept a number from the last list, a prefix, or a whole identifier."""
    token = token.strip()
    if token.isdigit():
        shortlist = load_shortlist(corpus)
        n = int(token)
        if not shortlist:
            die("no numbered list to pick from yet -- run `polymath search` or "
                "`polymath list` first")
        if not 1 <= n <= len(shortlist):
            die(f"there were only {len(shortlist)} entries in that list")
        return shortlist[n - 1]
    if token in corpus.records:
        return token
    matches = [i for i in corpus.records if i.startswith(token)]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        die(f"no record matching {token!r}")
    die(f"{token!r} matches {len(matches)} records; give a few more characters")


def haystack(rec: dict) -> str:
    """All the searchable text of a record, with whitespace flattened so that a
    phrase still matches when the prose happens to wrap between its words."""
    raw = "\n".join(str(rec.get(k, "")) for k in ("title", "body", "what_was_tried"))
    return " ".join(raw.split()).lower()


def count_term(hay: str, term: str, substring: bool) -> int:
    term = " ".join(term.split()).lower()
    if not term:
        return 0
    if substring:
        return hay.count(term)
    return len(re.findall(r"(?<!\w)" + re.escape(term) + r"(?!\w)", hay))


def search_records(corpus: Corpus, terms: list, substring=False, rtype=None) -> list:
    """Returns (how many distinct terms matched, total hits, record), best first.
    Records containing ALL your words come before records containing only some."""
    out = []
    for rec in corpus.records.values():
        if rtype and rec.get("type") != rtype:
            continue
        hay = haystack(rec)
        counts = [count_term(hay, t, substring) for t in terms]
        matched = sum(1 for c in counts if c)
        if matched:
            out.append((matched, sum(counts), rec))
    out.sort(key=lambda r: (-r[0], -r[1], r[2].get("title", "")))
    return out


def print_shortlist(corpus: Corpus, records: list, show_status=True):
    """One numbered line per record, plus the short identifier."""
    ids = []
    for n, rec in enumerate(records, start=1):
        ids.append(rec["id"])
        short = rec["id"].split("-", 1)[0]
        tag = status_tag(corpus, rec) if show_status else ""
        status = f"  [{tag}]" if tag else ""
        print(f"  {n:>3}  {rec['type']:<16} {rec.get('title', '')}{status}")
        print(f"       {short}   by {rec['author']}")
    save_shortlist(corpus, ids)
    if ids:
        print(f"\nUse the number to open one, e.g.  polymath show 1")


# --------------------------------------------------------------------------
# derived status
# --------------------------------------------------------------------------

def verification_status(corpus: Corpus, rid: str) -> str:
    """What is actually known about an assertion. Computed, never stored.

    The distinction a mathematician cares about first is proved against not
    proved, and it is categorical, so it is carried by the record TYPE:
    `conjecture` against `theorem`. This function then says what backs that up,
    which is the part nobody should be able to assert about their own work.

    Note the deliberate nag at the end: a `theorem` with no proof, no reference
    and no machine check is indistinguishable from a conjecture except by its
    author's say-so, and says so.
    """
    rec = corpus.records.get(rid, {})
    rtype = rec.get("type")
    if rtype not in ("theorem", "conjecture"):
        return ""

    verdicts = [r for r in corpus.records.values()
                if r.get("type") == "verdict"
                and any(l.get("target") == rid for l in r.get("links", []))]
    for v in verdicts:
        reviews = [r for r in corpus.records.values()
                   if r.get("type") == "statement_review"
                   and r.get("reviews") == v["id"]
                   and r.get("author") not in (v.get("author"), rec.get("author"))]
        if reviews:
            return ("verified" if rtype == "theorem" else
                    "machine-verified -- this should now be superseded by a theorem")
    if verdicts:
        return "machine-checked, awaiting an independent statement review"

    proved_in = [l.get("target") for l in rec.get("links", [])
                 if l.get("rel") == "proved_in"]
    refs = [l.get("target") for l in rec.get("links", [])
            if l.get("rel") == "cites"
            and corpus.records.get(l.get("target"), {}).get("type") == "reference"]
    args = [r for r in corpus.records.values()
            if r.get("type") == "argument"
            and any(l.get("target") == rid and l.get("rel") in ("supports", "answers")
                    for l in r.get("links", []))]
    if rtype == "conjecture":
        if args:
            return "conjecture, with a partial argument attached"
        return "conjecture, not proved"
    if proved_in and args:
        return "proved in the literature, with an argument here too"
    if proved_in:
        return "proved in the literature"
    if args:
        return "proof attached here"
    if refs:
        return ("asserted as proved: the ingredients are cited, but the derivation "
                "is not written out anywhere here")
    return "asserted as proved, but no proof, reference or machine check is attached"


def status_tag(corpus: Corpus, rec: dict) -> str:
    """The short form used in listings."""
    rtype = rec.get("type")
    if rtype == "conjecture":
        return "conjecture"
    if rtype == "theorem":
        s = verification_status(corpus, rec["id"])
        if s == "verified":
            return "verified"
        if s.startswith("proved in the literature"):
            return "in the literature"
        if s.startswith("proof attached"):
            return "proof here"
        if s.startswith("asserted as proved: the ingredients"):
            return "proof not written out"
        if s.startswith("machine-checked"):
            return "checked, needs review"
        return "NO PROOF ATTACHED"
    if rtype == "question" and rec.get("status") == "open":
        return "open"
    return ""



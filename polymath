def cmd_browse(args):
    """Write a clickable page of the whole corpus and open it in a browser."""
    import html as _html
    import webbrowser
    corpus = Corpus.find(Path(args.root) if args.root else None)
    recs = sorted(corpus.records.values(), key=lambda r: (r.get("type", ""), r.get("title", "")))
    if not recs:
        die("there are no records yet")

    def esc(x):
        return _html.escape(str(x or ""))

    toc, blocks = [], []
    for rec in recs:
        rid = rec["id"]
        toc.append(f'<a href="#{esc(rid)}">{esc(rec.get("title"))}</a><br>')
        tags = ""
        if rec.get("type") in ("theorem", "conjecture"):
            tags = f'<span class="tag">{esc(verification_status(corpus, rid))}</span>'
        links = ""
        if rec.get("links"):
            items = []
            for l in rec["links"]:
                tgt = corpus.records.get(l.get("target"), {})
                label = esc(tgt.get("title") or l.get("target"))
                items.append(f'{esc(l.get("rel"))} &rarr; '
                             f'<a href="#{esc(l.get("target"))}">{label}</a>')
            links = '<div class="links">' + "<br>".join(items) + "</div>"
        inbound = [(l["rel"], r) for r in recs for l in r.get("links", [])
                   if l.get("target") == rid]
        if inbound:
            items = [f'{esc(rel)} &larr; <a href="#{esc(r["id"])}">{esc(r.get("title"))}</a>'
                     for rel, r in inbound]
            links += '<div class="links">' + "<br>".join(items) + "</div>"
        tried = (f'<div class="tried"><b>What was tried</b>\n{esc(rec["what_was_tried"])}</div>'
                 if rec.get("what_was_tried") else "")
        blocks.append(
            f'<div class="rec" id="{esc(rid)}">'
            f'<div class="type">{esc(rec.get("type"))}{tags}</div>'
            f'<div class="title">{esc(rec.get("title"))}</div>'
            f'<div class="meta">{esc(rid)} &middot; by {esc(rec.get("author"))} &middot; '
            f'{esc(rec.get("provenance", {}).get("kind"))}</div>'
            f'<div class="body">{esc(rec.get("body"))}</div>{tried}{links}</div>')

    page = HTML_PAGE.format(
        count=len(recs), people=len(corpus.people),
        when=_dt.datetime.now().strftime("%Y-%m-%d %H:%M"),
        toc="".join(toc), records="".join(blocks))
    out = corpus.root / ".polymath-browse.html"
    out.write_text(page, encoding="utf-8")
    print(f"wrote {out}")
    if not args.no_open:
        webbrowser.open(out.as_uri())
        print("opened in your web browser")
    return 0


def cmd_sync(args):
    corpus = Corpus.find(Path(args.root) if args.root else None)
    root = str(corpus.root)

    def git(*a, check=True):
        r = subprocess.run(["git", "-C", root, *a], capture_output=True, text=True)
        if check and r.returncode != 0:
            die(f"git {' '.join(a)} failed: {r.stderr.strip()}")
        return r.stdout.strip()

    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    before = git("rev-parse", "HEAD")
    git("fetch", "origin", branch)
    remote = git("rev-parse", f"origin/{branch}")
    if before == remote:
        print("already up to date.")
        return 0
    # A rewrite of shared history is either a mistake or an attack. Refuse it
    # loudly rather than quietly accepting a different past.
    r = subprocess.run(["git", "-C", root, "merge-base", "--is-ancestor", before, remote])
    if r.returncode != 0:
        print("REFUSING TO SYNC.", file=sys.stderr)
        print(f"The shared history has been rewritten: your current commit {before[:12]} is no",
              file=sys.stderr)
        print("longer part of it. That is either a mistake or an attack. Do not override this",
              file=sys.stderr)
        print("until an administrator has announced and explained the rewrite, and check that",
              file=sys.stderr)
        print("other members saw the same announcement.", file=sys.stderr)
        return 2
    git("merge", "--ff-only", f"origin/{branch}")
    print(f"updated {before[:12]} -> {remote[:12]}")
    corpus._records = None
    problems = run_validation(corpus)
    if problems:
        print(f"\nWARNING: {len(problems)} validation problem(s) after sync:", file=sys.stderr)
        for p in problems[:20]:
            print("  " + str(p), file=sys.stderr)
        return 1
    return 0


def cmd_doctor(args):
    corpus = Corpus.find(Path(args.root) if args.root else None)
    cfg = read_config(corpus)
    ok = True

    def check(label, good, detail=""):
        nonlocal ok
        print(f"  [{'ok' if good else '--'}] {label}")
        if not good and detail:
            for line in detail.split("\n"):
                print(f"          {line}")
        ok = ok and good

    check("ssh-keygen is installed (this is what signs your records)",
          shutil.which("ssh-keygen") is not None)
    check("git is installed (this is what stores the shared history)",
          shutil.which("git") is not None)
    check("python is new enough (3.11 or later)", sys.version_info >= (3, 11))
    check("your name is configured", bool(cfg.get("handle")),
          "polymath does not know who you are yet. To fix, run:\n"
          "    polymath init --handle <your-handle>")
    key = Path(cfg.get("key", "")).expanduser() if cfg.get("key") else None
    check("your key is configured", bool(key and key.exists()),
          "polymath does not know which key to stamp your records with. To fix, run:\n"
          "    polymath init --key ~/.ssh/id_ed25519")
    if cfg.get("handle"):
        check("you are on the project's member list", cfg["handle"] in corpus.people,
              "An administrator has to add you, by putting the public half of your key\n"
              "into people/<your-handle>.toml. Until then your records will be refused.")
        if key and key.exists() and cfg["handle"] in corpus.people:
            probe = b"polymath doctor probe"
            try:
                sig = ssh_sign(probe, key)
                check("your key stamps records the project will accept",
                      ssh_verify(probe, sig, cfg["handle"], corpus.allowed_signers()),
                      "The key the project has on file for you is not the one you are\n"
                      "signing with. Either point polymath at the right key, or ask an\n"
                      "administrator to update people/" + cfg["handle"] + ".toml.")
            except SystemExit:
                check("your key signs", False)
    if (corpus.root / ".git").exists():
        cs = subprocess.run(["git", "-C", str(corpus.root), "config", "--get", "core.symlinks"],
                            capture_output=True, text=True).stdout.strip()
        check("this copy will not create symbolic links", cs == "false",
              "A symbolic link is a file that is really a pointer to some other file\n"
              "on your computer. If one got into the shared record pointing at, say,\n"
              "your private key, then anything that innocently read 'that file' would\n"
              "read your key instead. This setting tells git never to create one here.\n"
              "You want it on, and it costs you nothing: the project forbids symbolic\n"
              "links anyway. To fix, run:\n"
              "    git config core.symlinks false")
    print()
    print("Reminders that no program can enforce for you:")
    print("  * Do NOT open the project's Lean files in an editor with Lean support")
    print("    switched on. (Lean is the language the project uses for proofs a computer")
    print("    can check.) Opening such a file runs the project's build settings, and")
    print("    those settings are themselves a program, so this runs somebody else's")
    print("    code on your machine. Read them as plain text.")
    print("  * Anything an assistant drafted may have been influenced by text somebody")
    print("    else wrote. Read your own drafts as if a stranger wrote them.")
    return 0 if ok else 1


